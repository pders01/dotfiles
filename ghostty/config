theme = light:StoneLight,dark:Stone

background-opacity = 0.90
background-blur-radius= 20

font-family = "IosevkaTerm Nerd Font Mono"
font-size = 18

window-padding-x = 16
window-padding-y = 16

keybind = alt+left=unbind
keybind = alt+right=unbind
macos-option-as-alt = true

keybind = cmd+ctrl+enter=toggle_quick_terminal
quick-terminal-position = center
quick-terminal-size = 50%, 75%

macos-non-native-fullscreen = true
keybind = shift+enter=text:\n

# 1/3 | 2/3 default for 2K display at 2560 / 6 ~= 426
keybind = cmd+s>2=new_split:left
keybind = chain=resize_split:left,426

